# ── Public site URL (SEO canonicals) ──────────────────────────────────────────
VITE_SITE_URL=https://level-up-tile.vercel.app

# ── xAI Grok Voice (Aria) ─────────────────────────────────────────────────────
# Create a key at https://console.x.ai — enables realtime speech-to-speech.
XAI_API_KEY=

# ── Lead delivery ─────────────────────────────────────────────────────────────
# Resend: https://resend.com — emails new bookings to your inbox
RESEND_API_KEY=
RESEND_FROM="Level Up Tile <onboarding@resend.dev>"
LEAD_NOTIFY_EMAIL=hello@leveluptile.com

# Optional Zapier / Make / CRM webhook (JSON POST on each booking)
LEAD_WEBHOOK_URL=

# ── Analytics ─────────────────────────────────────────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=

# ── Database (optional; PGLite used when unset) ───────────────────────────────
DATABASE_URL=

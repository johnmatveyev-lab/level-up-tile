# ── Public site URL (SEO canonicals) ──────────────────────────────────────────
VITE_SITE_URL=https://level-up-tile.vercel.app

# ── xAI Grok Voice (Aria) ─────────────────────────────────────────────────────
# Create a key at https://console.x.ai — enables realtime speech-to-speech.
XAI_API_KEY=

# ── Lead delivery ─────────────────────────────────────────────────────────────
# Resend: https://resend.com — emails new bookings to your inbox + client confirm
RESEND_API_KEY=
RESEND_FROM="Level Up Tile <onboarding@resend.dev>"
LEAD_NOTIFY_EMAIL=johnmatveyev@gmail.com
# Set to "false" to skip client confirmation emails
LEAD_CLIENT_EMAIL=true

# Optional Zapier / Make / CRM webhook (JSON POST on each booking)
LEAD_WEBHOOK_URL=

# ── Admin CRM (/admin) ────────────────────────────────────────────────────────
# Token for the lead inbox. Local default if unset: levelup-admin
ADMIN_TOKEN=

# ── Analytics ─────────────────────────────────────────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_PLAUSIBLE_DOMAIN=

# ── Database (optional; PGLite used when unset) ───────────────────────────────
# Neon/Postgres recommended for production so bookings survive deploys.
DATABASE_URL=
